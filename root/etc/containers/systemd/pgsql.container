[Unit]
Description=PostgresSQL for TAO Community
After=taosetup-install.service
After=network-online.target

[Container]
Image=docker.io/postgres:17-alpine
Pull=Never
IP=10.247.40.5
Network=deps.network
NetworkAlias=pgsql
Environment=POSTGRES_USER=postgres
Environment=POSTGRES_PASSWORD=postgres
Volume=/var/lib/tao-ce/dependencies/pgsql:/var/lib/postgresql/data:z,U

[Service]
Restart=always
ExecStartPre=mkdir -p /var/lib/tao-ce/dependencies/pgsql
ExecStartPre=/usr/libexec/tao-ce/cozy/pull_image.sh -m remote -n docker.io/postgres:17-alpine -p docker.io/postgres:17-alpine
RestartSec=5s
[Install]
WantedBy=multi-user.target