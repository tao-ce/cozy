[Unit]
Description=Pubsub emulator for TAO Community
After=appliance-setup.service
After=network-online.target

[Container]
Image=quay.io/tao-ce/services/pubsub-emulator:latest
NetworkAlias=pubsub
IP=10.247.40.8
Network=deps.network

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=600s

[Install]
WantedBy=multi-user.target