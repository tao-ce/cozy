[Unit]
Description=Pubsub emulator for TAO Community
After=taosetup-install.service
After=network-online.target

[Container]
Image=quay.io/tao-ce/services/pubsub-emulator:latest
Pull=Never
NetworkAlias=pubsub
IP=10.247.40.8
Network=deps.network

[Service]
Restart=always
RestartSec=5s
TimeoutStartSec=600s
ExecStartPre=/usr/libexec/tao-ce/cozy/pull_image.sh -m remote -n quay.io/tao-ce/services/pubsub-emulator:latest -p quay.io/tao-ce/services/pubsub-emulator:latest

[Install]
WantedBy=multi-user.target